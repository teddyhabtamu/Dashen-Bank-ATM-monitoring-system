# ──────────────────────────────────────────
# Dashen Bank ATM Monitoring — Environment
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# PostgreSQL
# POSTGRES_PASSWORD is the DB password for all services (must match DB_PASS)
POSTGRES_PASSWORD=zabbix
DB_PASS=zabbix

# GLPI database (MariaDB)
MYSQL_ROOT_PASSWORD=zabbix
MYSQL_PASSWORD=zabbix

# Zabbix web UI
ZBX_USER=Admin
ZBX_PASS=zabbix
ZBX_URL=http://localhost:8080/api_jsonrpc.php

# Report Portal
REPORT_PORTAL_PORT=8888
ADMIN_USER=admin
ADMIN_PASS=changeme
FLASK_SECRET_KEY=generate-a-random-secret-key-here
FLASK_DEBUG=0

# Grafana
GRAFANA_ADMIN_PASSWORD=<set-a-strong-password>
# Report Portal link back to Grafana (http://<host>:3000)
GRAFANA_URL=http://localhost:3000
# Sidebar quick-links in the Report Portal (browser URLs, not API endpoints)
ZABBIX_UI_URL=http://localhost:8080
GLPI_UI_URL=http://localhost:8082

# pgAdmin
PGADMIN_EMAIL=admin@dashenbank.com
PGADMIN_PASSWORD=<set-a-strong-password>

# SMTP (email alerts — optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=zabbix@example.com

# Simulator gateway IP (Docker network gateway)
GATEWAY_IP=172.17.0.1

# Max ATMs to simulate (0 = unlimited)
MAX_SIMULATED_ATMS=10

# GLPI (values are machine-specific — generate your own, never commit real ones)
GLPI_USER=glpi
GLPI_API_PASSWORD=change-me-strong-glpi-password

# Africa's Talking SMS webhook key (optional — only if SMS alerts are used)
AT_API_KEY=

# ── Portal database ──────────────────────────────────────────────────────────
# Which database holds the portal's tables. Leave unset (or "zabbix") until the
# split is switched on: the portal shares a database with Zabbix's own
# configuration. Set to "portal" after scripts/split_portal_db.sh has run and
# verified, to move every portal writer onto the dedicated database.
#
# Zabbix itself never reads this. Only report-portal, cash-watcher,
# anomaly-detector, network-correlator, state-manager and iso8583-gateway do.
PORTAL_DB_NAME=zabbix

# ── UAT-only keys, added 2026-10-17 ───────────────────────────────────────────
# These lived only in .env.uat, which was tracked. A tracked file cannot be
# rescued by an ignore rule, so it is now untracked and lives only on the server
# alongside the real .env. They are recorded here as placeholders so the template
# stays complete.
APPS_VM_IP=<app-server-ip>
DATA_VM_IP=<data-server-ip>
BASE_URL=<portal-base-url>
AUTH_MODE=ldap
ENABLE_SIMULATORS=false
ISO8583_MODE=simulation
SWITCH_HOST=<atm-switch-ip>
SWITCH_PORT=9876
ATM_SNMP_COMMUNITY=<snmp-community-string>
ZABBIX_USER=<zabbix-api-user>
ZABBIX_PASS=<zabbix-api-password>
GLPI_APP_TOKEN=<generate-a-glpi-app-token>

# ── On-demand ATM image bridge ───────────────────────────────────────────────
# The host service scripts/atm_image_bridge.py listens on a Unix socket and
# holds the HMAC key. The portal gets only the socket mount and this bearer
# token; it never gets the HMAC key or an ATM path. Generate with:
#   openssl rand -hex 32
# Put the same value in /etc/atm-monitoring/image-bridge.env on the host.
ATM_IMAGE_BRIDGE_SOCKET=/run/atm-image-bridge/bridge.sock
# GID of the account that owns the bridge socket (usually the deploy user).
# The portal runs as an unprivileged user and joins this group read-only.
# Find it with: id -g <bridge-service-user>
ATM_IMAGE_BRIDGE_GID=1000
ATM_IMAGE_BRIDGE_TOKEN=

# ── ATM agent profile ────────────────────────────────────────────────────────
# HMAC-SHA256 key for downloadable agent profiles. Leave empty only in the UAT
# lab: without it profiles are served unsigned and the page says so.
# Generate with: openssl rand -hex 32
ATM_PROFILE_SECRET=
# Optional Server= override for lab boxes that do not sit behind a district
# proxy. Leave empty in production so the district proxy is used.
ATM_AGENT_SERVER=
