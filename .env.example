# ──────────────────────────────────────────
# Dashen Bank ATM Monitoring — Environment
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# PostgreSQL
# POSTGRES_PASSWORD is the DB password for all services (must match DB_PASS)
POSTGRES_PASSWORD=zabbix
DB_PASS=zabbix

# GLPI database (MariaDB)
MYSQL_ROOT_PASSWORD=zabbix
MYSQL_PASSWORD=zabbix

# Zabbix web UI
ZBX_USER=Admin
ZBX_PASS=zabbix
ZBX_URL=http://localhost:8080/api_jsonrpc.php

# Report Portal
REPORT_PORTAL_PORT=8888
ADMIN_USER=admin
ADMIN_PASS=changeme
FLASK_SECRET_KEY=generate-a-random-secret-key-here
FLASK_DEBUG=0

# Grafana
GRAFANA_ADMIN_PASSWORD=<set-a-strong-password>
# Report Portal link back to Grafana (http://<host>:3000)
GRAFANA_URL=http://localhost:3000
# Sidebar quick-links in the Report Portal (browser URLs, not API endpoints)
ZABBIX_UI_URL=http://localhost:8080
GLPI_UI_URL=http://localhost:8082

# pgAdmin
PGADMIN_EMAIL=admin@dashenbank.com
PGADMIN_PASSWORD=<set-a-strong-password>

# SMTP (email alerts — optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=zabbix@example.com

# Simulator gateway IP (Docker network gateway)
GATEWAY_IP=172.17.0.1

# Max ATMs to simulate (0 = unlimited)
MAX_SIMULATED_ATMS=10

# GLPI (values are machine-specific — generate your own, never commit real ones)
GLPI_USER=glpi
GLPI_API_PASSWORD=change-me-strong-glpi-password

# Africa's Talking SMS webhook key (optional — only if SMS alerts are used)
AT_API_KEY=
