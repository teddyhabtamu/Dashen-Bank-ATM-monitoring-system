# Database Passwords
POSTGRES_PASSWORD=your_postgres_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_PASSWORD=your_mysql_password_here
DB_PASS=your_db_password_here

# Grafana
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# GLPI
GLPI_API_PASSWORD=your_glpi_api_password_here

# Report Portal Admin (change these immediately on first deploy)
ADMIN_USER=admin
ADMIN_PASS=choose-a-strong-password
FLASK_SECRET_KEY=generate-a-random-64-char-hex-string

# Service URLs (update for production deployment)
GRAFANA_URL=http://your-server-ip:3002
REPORT_PORTAL_PORT=8888
