# ──────────────────────────────────────────
# Dashen Bank ATM Monitoring — Environment
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# PostgreSQL
# POSTGRES_PASSWORD is the DB password for all services (must match DB_PASS)
POSTGRES_PASSWORD=zabbix
DB_PASS=zabbix

# GLPI database (MariaDB)
MYSQL_ROOT_PASSWORD=zabbix
MYSQL_PASSWORD=zabbix

# Zabbix web UI
ZBX_USER=Admin
ZBX_PASS=zabbix

# Report Portal
REPORT_PORTAL_PORT=8888
ADMIN_USER=admin
ADMIN_PASS=changeme
FLASK_SECRET_KEY=generate-a-random-secret-key-here
FLASK_DEBUG=0

# Grafana
GRAFANA_ADMIN_PASSWORD=dashen2024
# Report Portal link back to Grafana (http://<host>:3002)
GRAFANA_URL=http://localhost:3002

# pgAdmin
PGADMIN_EMAIL=admin@dashenbank.com
PGADMIN_PASSWORD=dashen2024

# SMTP (email alerts — optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=zabbix@example.com

# Simulator gateway IP (Docker network gateway)
GATEWAY_IP=172.17.0.1

# Max ATMs to simulate (0 = unlimited)
MAX_SIMULATED_ATMS=10

# GLPI (should match glpi_setup.py defaults)
GLPI_USER=glpi
GLPI_API_PASSWORD=DashenGLPI2024
