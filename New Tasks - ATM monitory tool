@app.route('/api/ej-search')
def api_ej_search():
    """API endpoint for EJ search — queries PostgreSQL atm_transactions."""
    card = request.args.get('card', '').strip()
    atm = request.args.get('atm', '').strip()
    txn_type = request.args.get('txn_type', '').strip()
    status_filter = request.args.get('status', '').strip()
    from_date = request.args.get('from_date', '').strip()
    to_date = request.args.get('to_date', '').strip()

    try:
        conn = get_db()
        cur = conn.cursor()

        conditions = ["1=1"]
        params = []

        if card:
            conditions.append("card_masked LIKE %s")
            params.append(f'%{card}')

        if atm:
            conditions.append("t.atm_id = %s")
            params.append(atm)

        if txn_type:
            conditions.append("txn_type = %s")
            params.append(txn_type)

        if status_filter:
            conditions.append("t.status = %s")
            params.append(status_filter)

        if from_date:
            conditions.append("recorded_at >= %s")
            params.append(from_date)

        if to_date:
            conditions.append("recorded_at <= %s::date + interval '1 day'")
            params.append(to_date)

        where = ' AND '.join(conditions)

        cur.execute(f"""
            SELECT
                TO_CHAR(t.recorded_at AT TIME ZONE 'Africa/Addis_Ababa',
                        'YYYY-MM-DD HH24:MI:SS') as time,
                t.atm_id,
                COALESCE(l.branch, t.atm_id) as branch,
                COALESCE(t.vendor, l.vendor, 'NCR') as vendor,
                t.txn_type,
                COALESCE(t.card_masked, '—') as card,
                CASE WHEN t.amount IS NOT NULL
                     THEN TO_CHAR(t.amount, 'FM999,999,990.00')
                     ELSE NULL END as amount,
                t.status,
                t.auth_code,
                t.error_code
            FROM atm_transactions t
            LEFT JOIN atm_locations l ON t.atm_id = l.atm_id
            WHERE {where}
            ORDER BY t.recorded_at DESC
            LIMIT 200
        """, params)

        rows = cur.fetchall()
        total = len(rows)

        result = [{
            'time': r[0], 'atm_id': r[1], 'branch': r[2],
            'vendor': r[3], 'txn_type': r[4], 'card': r[5],
            'amount': r[6], 'status': r[7], 'auth': r[8], 'error': r[9]
        } for r in rows]

        cur.close()
        conn.close()
        return jsonify({'total': total, 'rows': result})

    except Exception as e:
        return jsonify({'error': str(e), 'total': 0, 'rows': []})
