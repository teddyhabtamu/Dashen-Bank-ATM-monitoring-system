# ============================
# Dashen Bank ATM Monitoring
# UAT Environment Variables
# ============================
# NOTE: Change passwords before UAT goes live; chmod 600 this file

POSTGRES_PASSWORD=<uat-strong-password>
GRAFANA_ADMIN_PASSWORD=<uat-strong-password>
MYSQL_ROOT_PASSWORD=<uat-strong-password>
MYSQL_PASSWORD=<uat-strong-password>
DB_PASS=<must-match-POSTGRES_PASSWORD>
GLPI_APP_TOKEN=<generated-during-glpi-setup>
GLPI_API_PASSWORD=<password-for-glpi-api>
GRAFANA_URL=http://172.26.208.176:3000
ZABBIX_UI_URL=http://172.26.208.176:8080
GLPI_UI_URL=http://172.26.208.176:8082
REPORT_PORTAL_PORT=8888

# Report Portal (generate: openssl rand -base64 16)
ADMIN_USER=admin
ADMIN_PASS=<uat-strong-password>
FLASK_SECRET_KEY=<openssl-rand-hex-24>

# Zabbix API (used by setup/sync scripts and the network-correlator)
ZBX_USER=Admin
ZBX_PASS=<change-factory-default-after-first-login>
ZBX_URL=http://172.26.208.176:8080/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASS=${ZBX_PASS}

# GLPI API user
GLPI_USER=glpi

# SMTP for scheduled report emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=atm-monitor@dashenbank.com

# UAT VM topology (consumed by the docker-compose files)
APPS_VM_IP=172.26.208.176
DATA_VM_IP=172.26.21.50

# Africa's Talking SMS alerts (optional; set before UAT goes live)
AT_API_KEY=

# (No simulators run in UAT — the 2 real test ATMs are polled over real SNMP.)

# Default SNMP community for ATM Zabbix host sync (override per-ATM via atm_locations.snmp_community)
ATM_SNMP_COMMUNITY=CHANGE_ME

# ISO 8583 transaction gateway (VM2)
# Default 'simulation' generates transaction events for the seeded ATMs so the
# transaction/anomaly pipeline is exercised. Set ISO8583_MODE=tcp and point the
# bank's ATM switch at this VM's IP on SWITCH_PORT to ingest REAL transactions.
ISO8583_MODE=simulation
SWITCH_HOST=0.0.0.0
SWITCH_PORT=9876

# Simulators are removed in UAT; keep report-portal's simulator-only features off
ENABLE_SIMULATORS=false