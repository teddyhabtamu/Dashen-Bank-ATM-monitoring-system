# Environments
# .env and every copy of it. A backup of a credentials file is exactly as
# sensitive as the original: .env.bak-ldap-test sat untracked and UNIGNORED on
# UAT-01, so the next `git add -A` would have published LDAP and database
# passwords to a public repository. The exact-name rule protected the file and
# nothing else.
.env*
!.env.example
venv/
env/

# Python
__pycache__/
*.pyc

# Logs and Backups
ej-logs/
*.log

# Raw live ATM journals may contain card/account data. Keep local copies out
# of git even when they are handed over as "sample" files in docs/.
docs/Sample*.txt
glpi_backup/

# OS and Artifacts
*.deb
*.pdf
*.xlsx
*.csv
!config/snmp/oid_mapping.csv.example
.DS_Store

# Runtime output. logs/ holds EJ journal pulls from live ATMs; dist/ is
# generated by scripts/capture_env_lock.sh and is reproducible at any time.
logs/
dist/

# ── Database artefacts: never commit these ───────────────────────────────────
# These contain real data - the ATM registry, transaction history, every GLPI
# ticket - and this repository may be public. backup_db.sh writes all of them
# here, so ignoring two specific filenames was not enough: portal_full_*.sql.gz,
# glpi_*.sql.gz, the three CSV exports and restore_db.sh's pre_restore_*.sql.gz
# were all untracked-but-unignored, waiting for the next `git add -A`.
#
# Only schema and seed files belong in git under config/postgres/.
config/postgres/*.sql.gz
config/postgres/*.csv   # redundant with the global *.csv above; kept so this block stands alone
config/postgres/*.sql
config/postgres/*.dump
!config/postgres/seed_uat_atms.sql
!config/postgres/uat_tables.sql

# Zabbix template backups created by scripts/generate_zabbix_templates.py
config/zabbix/*.simulator.bak

# Config backup bundles (contain .env secrets — never commit)
config/backups/

# Raw SNMP walks (contain internal IPs/MACs; evidence stays on the UAT host)
snmpwalk_output.txt
snmpwalk_*.txt
*:Zone.Identifier
