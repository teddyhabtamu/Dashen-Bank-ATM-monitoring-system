FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir --only-binary :all: psycopg2-binary==2.9.13 \
    && useradd --create-home --uid 10001 --shell /bin/false appuser

COPY --chown=appuser:appuser iso8583_gateway.py .

USER appuser
CMD ["python3", "-u", "iso8583_gateway.py"]
