          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  TO_CHAR(recorded_at AT TIME ZONE\r\n    'Africa/Addis_Ababa',\r\n    'HH24:MI:SS') as \"Time\",\r\n  txn_type as \"Type\",\r\n  card_masked as \"Card\",\r\n  COALESCE(amount::text, '-')\r\n    as \"Amount (ETB)\",\r\n  status as \"Status\",\r\n  COALESCE(auth_code, '-') as \"Auth\",\r\n  COALESCE(error_code, '-') as \"Error\",\r\n  source as \"Source\"\r\nFROM atm_transactions\r\nWHERE atm_id = '${selected_atm}'\r\nORDER BY recorded_at DESC\r\nLIMIT 50",
          "refId": "A",
          "sql": {
            "columns": [
              {
