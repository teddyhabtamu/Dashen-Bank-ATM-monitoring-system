          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    l.city as \"City\",\n    l.district as \"District\",\n    COUNT(*) as \"Total ATMs\",\n    SUM(CASE WHEN s.state = 'IN_SERVICE' THEN 1 ELSE 0 END) as \"In Service\",\n    SUM(CASE WHEN s.state = 'OUT_OF_SERVICE' THEN 1 ELSE 0 END) as \"Out of Service\",\n    SUM(CASE WHEN s.state = 'AGENT_DISCONNECTED' THEN 1 ELSE 0 END) as \"Disconnected\",\n    ROUND(100.0 * SUM(CASE WHEN s.state = 'IN_SERVICE' THEN 1 ELSE 0 END) / COUNT(*), 1)\n        as \"Availability %\"\nFROM atm_locations l\nLEFT JOIN atm_current_state s ON l.atm_id = s.atm_id\nGROUP BY l.city, l.district\nORDER BY COUNT(*) DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "ATM Status by City / Region",
      "type": "table"
    }
