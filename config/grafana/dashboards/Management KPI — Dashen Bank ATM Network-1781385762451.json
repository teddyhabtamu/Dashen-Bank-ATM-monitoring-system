          "rawSql": "SELECT\r\n  DATE_TRUNC('day', recorded_at) as \"time\",\r\n  ROUND(100.0 * SUM(CASE WHEN status='APPROVED' THEN 1 ELSE 0 END) / COUNT(*), 2) as \"Success Rate %\"\r\nFROM atm_transactions\r\nWHERE recorded_at >= NOW() - INTERVAL '7 days'\r\nGROUP BY 1\r\nORDER BY 1",
