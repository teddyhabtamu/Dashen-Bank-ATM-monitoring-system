   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_ATM-TRANSACTIONS}"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT s.state AS \"State\", COALESCE(c.cnt,0) AS \"Count\"\nFROM (VALUES ('IN_SERVICE'),('OUT_OF_SERVICE'),('AGENT_DISCONNECTED'),\n             ('IN_SUPERVISOR'),('HARDWARE_FAULT'),('OUT_OF_CASH'),('OFFLINE')) s(state)\nLEFT JOIN (SELECT state, COUNT(*) AS cnt FROM atm_current_state GROUP BY state) c\n  ON c.state = s.state\nORDER BY \"Count\" DESC",
     "refId": "A",
     "sql": {
      "columns": [
       {
        "parameters": [],
        "type": "function"
       }
      ],
      "groupBy": [
       {
        "property": {
         "type": "string"
        },
        "type": "groupBy"
       }
      ],
      "limit": 50
     }
    }
