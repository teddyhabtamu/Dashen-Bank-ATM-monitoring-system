     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT\r\n  l.atm_id,\r\n  l.branch,\r\n  l.district,\r\n  l.city,\r\n  l.latitude,\r\n  l.longitude,\r\n  l.vendor,\r\n  l.model,\r\n  COALESCE(t.transactions, 0) as transactions,\r\n  COALESCE(t.success_rate, 0) as success_rate,\r\n  COALESCE(t.atm_status,\r\n    'No Data') as atm_status\r\nFROM atm_locations l\r\nLEFT JOIN (\r\n  SELECT\r\n    atm_id,\r\n    COUNT(*) as transactions,\r\n    ROUND(100.0 * SUM(\r\n      CASE WHEN status='APPROVED'\r\n      THEN 1 ELSE 0 END\r\n    ) / COUNT(*), 1) as success_rate,\r\n    CASE\r\n      WHEN ROUND(100.0 * SUM(\r\n        CASE WHEN status='APPROVED'\r\n        THEN 1 ELSE 0 END\r\n      ) / COUNT(*), 1) >= 95\r\n      THEN 'Healthy'\r\n      WHEN ROUND(100.0 * SUM(\r\n        CASE WHEN status='APPROVED'\r\n        THEN 1 ELSE 0 END\r\n      ) / COUNT(*), 1) >= 80\r\n      THEN 'Degraded'\r\n      ELSE 'Critical'\r\n    END as atm_status\r\n  FROM atm_transactions\r\n  WHERE recorded_at >=\r\n    NOW() - INTERVAL '1 hour'\r\n  GROUP BY atm_id\r\n) t ON l.atm_id = t.atm_id\r\nORDER BY l.atm_id",
     "refId": "A",
     "sql": {
      "columns": [
       {
        "parameters": [],
        "type": "function"
       }
      ],
      "groupBy": [
       {
        "property": {
         "type": "string"
        },
        "type": "groupBy"
       }
      ],
      "limit": 50
     }
    }
