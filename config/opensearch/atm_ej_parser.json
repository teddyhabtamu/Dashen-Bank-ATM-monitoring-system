{
  "description": "Parse ATM Electronic Journal log lines (NCR + GRG, legacy and current shapes) into a structured nested schema: atm.id, terminal.id, transaction.*, card.masked, fault.*, event.category. Referenced by filebeat.yml (output.elasticsearch.pipeline). NDC records (ESC-led [020t*SEQ*MM/DD/YYYY*HH:MM*TEXT, proven live 2026-10-13) are split by filebeat multiline, then grokked here. Control bytes are stripped and PANs scrubbed (first6******last4) BEFORE storage, so raw PANs never rest at rest — portal display-scrub is defense in depth. Real (non-simulator) EJ lines that do not match the grok patterns are retained verbatim in `ej_raw` and tagged `ej_parsed:false` so they can be tuned later without data loss.",
  "processors": [
    {
      "gsub": {
        "field": "message",
        "pattern": "[\\x00-\\x1F]",
        "replacement": "",
        "ignore_missing": true
      }
    },
    {
      "gsub": {
        "field": "message",
        "pattern": "\\b(\\d{6})\\d{6,9}(\\d{4})\\b",
        "replacement": "$1******$2",
        "ignore_missing": true
      }
    },
    {
      "grok": {
        "field": "message",
        "patterns": [
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| SEQ=%{DATA:transaction.sequence} \\| CARD=%{DATA:card.masked} \\| AMOUNT=%{NUMBER:transaction.amount:float} \\| CURRENCY=%{DATA:transaction.currency} \\| STATUS=%{DATA:transaction.status}( \\| AUTH=%{DATA:transaction.auth_code})?$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| SEQ=%{DATA:transaction.sequence} \\| CARD=%{DATA:card.masked} \\| STATUS=%{DATA:transaction.status}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| CARD=%{DATA:card.masked} \\| AMOUNT=%{NUMBER:transaction.amount:float} \\| CURRENCY=%{DATA:transaction.currency} \\| STATUS=%{DATA:transaction.status}( \\| AUTH=%{DATA:transaction.auth_code})?$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| CARD=%{DATA:card.masked} \\| STATUS=%{DATA:transaction.status}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| VENDOR=%{DATA:vendor} \\| TXN_CODE=%{DATA:transaction.type} \\| SEQ=%{DATA:transaction.sequence} \\| ACCT_NO=%{DATA:card.masked} \\| AMOUNT=%{NUMBER:transaction.amount:float} \\| CURRENCY=%{DATA:transaction.currency} \\| RESP_CODE=%{DATA:transaction.status}( \\| AUTH(_CODE)?=%{DATA:transaction.auth_code})?$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| VENDOR=%{DATA:vendor} \\| EVENT=%{DATA:event.category} \\| FAULT_CODE=%{DATA:fault.code} \\| FAULT_DESC=%{DATA:fault.desc}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:fault.desc} \\| CASSETTE=%{DATA:fault.cassette} \\| TECH_CODE=%{DATA:fault.code}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:event.action} \\| OPERATOR=%{DATA:operator_id}$"
        ],
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "message",
        "patterns": [
          "^\\[020t\\*(?<transaction.sequence>[^*]*)\\*(?<event_time>\\d{2}/\\d{2}/\\d{4}\\*\\d{2}:\\d{2})\\*(?<ndc.text>[\\s\\S]*)$"
        ],
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "ndc.text",
        "patterns": [
          "[\\s\\S]*?(?<transaction.status>APPROVED|DECLINED|TIMEOUT|ERROR)[\\s\\S]*"
        ],
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "ndc.text",
        "patterns": [
          "[\\s\\S]*?(?<transaction.type>WITHDRAWAL|BALANCE_INQ|MINI_STATEMENT|TRANSFER|CARDLESS_TXN)[\\s\\S]*"
        ],
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "ndc.text",
        "patterns": [
          "[\\s\\S]*?(?<card.masked>\\d{6}\\*{6}\\d{4})[\\s\\S]*"
        ],
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "ndc.text",
        "patterns": [
          "[\\s\\S]*?(?<transaction.amount>\\d+\\.\\d{2})[\\s\\S]*"
        ],
        "ignore_failure": true
      }
    },
    {
      "remove": {
        "field": "transaction.amount",
        "if": "ctx.transaction?.type != 'WITHDRAWAL' && ctx.transaction?.type != 'TRANSFER'",
        "ignore_missing": true
      }
    },
    {
      "grok": {
        "field": "ndc.text",
        "patterns": [
          "TRANSACTION\\s+(?:DECLINED|TIMEOUT|ERROR)\\s+(?<fault.code>\\d{2})"
        ],
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "ndc.text",
        "patterns": [
          "\\*PRIMARY (?<component.name>[A-Z ]+) ACTIVATED\\*"
        ],
        "ignore_failure": true
      }
    },
    {
      "set": {
        "if": "ctx.component?.name != null && ctx.event?.category == null",
        "field": "event.category",
        "value": "COMPONENT"
      }
    },
    {
      "grok": {
        "field": "log.file.path",
        "patterns": [
          ".*/(?<atm.host>[^/]+)$"
        ],
        "ignore_failure": true
      }
    },
    {
      "set": {
        "if": "ctx.atm?.host != null && ctx.atm.host.contains('TESTMACHINE')",
        "field": "atm.id",
        "value": "ATM-TEST-NCR"
      }
    },
    {
      "set": {
        "if": "ctx.atm?.host != null && ctx.atm.host.contains('TESTGRG')",
        "field": "atm.id",
        "value": "ATM-TEST-GRG"
      }
    },
    {
      "trim": {
        "field": "transaction.status",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.type",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.currency",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.auth_code",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.sequence",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "card.masked",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "atm.id",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "terminal.id",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "vendor",
        "ignore_missing": true
      }
    },
    {
      "convert": {
        "field": "transaction.amount",
        "type": "float",
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "set": {
        "if": "ctx.ndc?.text != null && (ctx.ndc.text.contains('SST ') || ctx.ndc.text.contains('POWER-UP') || ctx.ndc.text.contains('SUPERVISOR') || ctx.ndc.text.contains('COMPONENT VERSIONS') || ctx.ndc.text.contains('EMV CHECKSUM'))",
        "field": "event.category",
        "value": "STATE"
      }
    },
    {
      "set": {
        "if": "ctx.event?.category == null && (ctx.transaction?.type != null || ctx.transaction?.status != null)",
        "field": "event.category",
        "value": "TXN"
      }
    },
    {
      "set": {
        "if": "ctx.event?.category == null && ctx.fault != null",
        "field": "event.category",
        "value": "FAULT"
      }
    },
    {
      "date": {
        "field": "event_time",
        "target_field": "@timestamp",
        "timezone": "Africa/Addis_Ababa",
        "formats": [
          "yyyy-MM-dd'T'HH:mm:ss",
          "yyyy-MM-dd HH:mm:ss",
          "MM/dd/yyyy'*'HH:mm"
        ],
        "ignore_failure": true
      }
    },
    {
      "remove": {
        "field": "event_time",
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "ej_raw",
        "value": "{{message}}",
        "ignore_failure": true
      }
    },
    {
      "set": {
        "if": "ctx.atm?.id != null",
        "field": "ej_parsed",
        "value": true
      }
    },
    {
      "set": {
        "if": "ctx.atm?.id == null",
        "field": "ej_parsed",
        "value": false
      }
    }
  ]
}
