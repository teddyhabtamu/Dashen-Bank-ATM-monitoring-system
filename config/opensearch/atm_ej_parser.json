{
      "description": "Parse ATM Electronic Journal log lines (NCR + GRG, legacy and current shapes) into a structured nested schema: atm.id, terminal.id, transaction.*, card.masked, fault.*, event.category. Referenced by filebeat.yml (output.elasticsearch.pipeline). Real (non-simulator) EJ lines that do not match the grok patterns are retained verbatim in `ej_raw` and tagged `ej_parsed:false` so they can be tuned later without data loss.",
  "processors": [
    {
      "grok": {
        "field": "message",
        "patterns": [
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| SEQ=%{DATA:transaction.sequence} \\| CARD=%{DATA:card.masked} \\| AMOUNT=%{NUMBER:transaction.amount:float} \\| CURRENCY=%{DATA:transaction.currency} \\| STATUS=%{DATA:transaction.status}( \\| AUTH=%{DATA:transaction.auth_code})?$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| SEQ=%{DATA:transaction.sequence} \\| CARD=%{DATA:card.masked} \\| STATUS=%{DATA:transaction.status}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| CARD=%{DATA:card.masked} \\| AMOUNT=%{NUMBER:transaction.amount:float} \\| CURRENCY=%{DATA:transaction.currency} \\| STATUS=%{DATA:transaction.status}( \\| AUTH=%{DATA:transaction.auth_code})?$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:transaction.type} \\| CARD=%{DATA:card.masked} \\| STATUS=%{DATA:transaction.status}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| VENDOR=%{DATA:vendor} \\| TXN_CODE=%{DATA:transaction.type} \\| SEQ=%{DATA:transaction.sequence} \\| ACCT_NO=%{DATA:card.masked} \\| AMOUNT=%{NUMBER:transaction.amount:float} \\| CURRENCY=%{DATA:transaction.currency} \\| RESP_CODE=%{DATA:transaction.status}( \\| AUTH(_CODE)?=%{DATA:transaction.auth_code})?$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:terminal.id} \\| VENDOR=%{DATA:vendor} \\| EVENT=%{DATA:event.category} \\| FAULT_CODE=%{DATA:fault.code} \\| FAULT_DESC=%{DATA:fault.desc}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:fault.desc} \\| CASSETTE=%{DATA:fault.cassette} \\| TECH_CODE=%{DATA:fault.code}$",
          "^%{TIMESTAMP_ISO8601:event_time} \\| %{DATA:atm.id} \\| %{DATA:event.category} \\| %{DATA:event.action} \\| OPERATOR=%{DATA:operator_id}$"
        ],
        "ignore_failure": true
      }
    },
    {
      "trim": {
        "field": "transaction.status",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.type",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.currency",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.auth_code",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "transaction.sequence",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "card.masked",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "atm.id",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "terminal.id",
        "ignore_missing": true
      }
    },
    {
      "trim": {
        "field": "vendor",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "if": "ctx.vendor == null",
        "field": "vendor",
        "value": "NCR"
      }
    },
    {
      "set": {
        "if": "ctx.event?.category == null && ctx.transaction != null",
        "field": "event.category",
        "value": "TXN"
      }
    },
    {
      "set": {
        "if": "ctx.event?.category == null && ctx.fault != null",
        "field": "event.category",
        "value": "FAULT"
      }
    },
    {
      "date": {
        "field": "event_time",
        "target_field": "@timestamp",
        "formats": [
          "yyyy-MM-dd'T'HH:mm:ss",
          "yyyy-MM-dd HH:mm:ss"
        ],
        "ignore_failure": true
      }
    },
    {
      "remove": {
        "field": "event_time",
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "ej_raw",
        "value": "{{message}}",
        "ignore_failure": true
      }
    },
    {
      "set": {
        "if": "ctx.atm?.id != null",
        "field": "ej_parsed",
        "value": true
      }
    },
    {
      "set": {
        "if": "ctx.atm?.id == null",
        "field": "ej_parsed",
        "value": false
      }
    }
  ]
}