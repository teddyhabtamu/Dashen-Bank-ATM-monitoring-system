# Host-side ATM image bridge secrets. Install as
# /etc/atm-monitoring/image-bridge.env, owned root:tewodros, mode 0640.
#
# Generate the token and key once:
#   openssl rand -hex 32
#
# The portal gets only ATM_IMAGE_BRIDGE_TOKEN (in the repo .env). It never
# gets ATM_IMAGE_HMAC_KEY_FILE or the key material.
ATM_IMAGE_BRIDGE_TOKEN=replace-with-openssl-rand-hex-32
ATM_IMAGE_HMAC_KEY_FILE=/etc/atm-monitoring/image-hmac.key
